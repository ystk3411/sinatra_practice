<div class="show-title">
  <%= h(@memo_data[:title]) %>
</div>
<div>
  <%= h(@memo_data[:content]) %>
</div>
<div class="show-page-button-container">
  <a href="/memo/<%= params[:id] %>/edit" class="edit-page-link">編集</a>
  <form action="/memo/<%= params[:id] %>" method="POST">
    <input type="hidden" value="delete" name="_method">
    <button type="submit">削除</button>
  </form>
</div>
