<h3>
  <%== h(@memo_data[:title]) %>
</h3>
<div>
  <%== h(@memo_data[:content]) %>
</div>
<div class="show-page-button-container">
  <form action="/memo/<%= params[:id] %>/edit" method="GET">
    <button type="submit">編集</button>
  </form>
  <form action="/memo/<%= params[:id] %>/delete" method="POST">
    <input type="hidden" value="delete" name="_method">
    <button type="submit">削除</button>
  </form>
</div>
