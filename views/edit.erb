<div>
  <form action="/memo/<%= params[:id] %>/update" method="POST">
    <h3>
      タイトル
    </h3>
    <div>
      <input type="text" name="title" value="<%= @memo_data[:title] %>">
    </div>
    <h3>
      本文
    </h3>
    <div>
      <textarea rows="4" name="content"><%= @memo_data[:content] %></textarea>
    </div>
    <input type="hidden" value="patch" name="_method">
    <button type="submit">保存</button>
  </form>
</div>
