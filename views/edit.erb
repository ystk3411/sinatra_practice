<div>
  <form action="/memos/<%= params[:id] %>" method="POST">
    <label for="title">
      タイトル
    </label>
    <div>
      <input type="text" name="title" value="<%= h(@memo[:title]) %>">
    </div>
    <label for="content">
      本文
    </label>
    <div>
      <textarea rows="4" name="content"><%= h(@memo[:content]) %></textarea>
    </div>
    <input type="hidden" value="patch" name="_method">
    <button type="submit">保存</button>
  </form>
</div>
