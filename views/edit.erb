<div>
  <form action="/memos/<%= params[:id] %>" method="POST">
    <label>
      タイトル
    </label>
    <div>
      <input type="text" name="title" value="<%= @memo[:title] %>">
    </div>
    <label>
      本文
    </label>
    <div>
      <textarea rows="4" name="content"><%= @memo[:content] %></textarea>
    </div>
    <input type="hidden" value="patch" name="_method">
    <button type="submit">保存</button>
  </form>
</div>
